  "minSupVersion": "19.0.1",
  "permissions": ["getTasks", "getAllProjects", "getAllTags", "addTask", "updateTask", "showSnack", "registerMenuEntry"],
  "dataSharing": [],
  "hooks": [],
  "iFrame": false
}
